# Copy to .env.local and fill in. Every one of these must ALSO be added by hand
# in the Vercel dashboard — .env.local is never uploaded, so a secret that works
# locally will 503 in production until it is set there too.

# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses Row Level Security. Server-only, never prefixed
# NEXT_PUBLIC_, never imported into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — credit top-ups
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the dashboard endpoint in production.
STRIPE_WEBHOOK_SECRET=

# Resend — invoice and notification email
RESEND_API_KEY=
# Must be a domain verified in Resend, or sends fail silently into spam.
EMAIL_FROM="MyQare <no-reply@myqare.com>"

# Public origin, used for absolute links in emails and invoice PDFs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
