# Copy to .env.local and fill in. Every one of these must ALSO be set by hand in
# the Vercel dashboard — .env.local is never uploaded, so a value that works
# locally fails in production until it is set there too.

# ---- Supabase ---------------------------------------------------------------
# Project settings > API. The anon key ships to the browser and is safe there;
# the service role key bypasses RLS entirely and must never reach the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe -----------------------------------------------------------------
# Only the secret key is used: Checkout is created server-side and the browser is
# redirected to Stripe's own page, so there is no publishable key in this app.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in Stripe. See SETUP.md for which events
# to subscribe to — the app handles four and ignoring one of them loses money.
STRIPE_WEBHOOK_SECRET=

# ---- Email ------------------------------------------------------------------
# Without RESEND_API_KEY nothing is sent and every send reports failure, which is
# correct but means offers, invoices and expiry warnings all go nowhere.
RESEND_API_KEY=
EMAIL_FROM="MyQare <no-reply@myqare.com>"
# Where the public contact form delivers. Unset, the form says so up front
# rather than accepting a message it cannot deliver.
CONTACT_EMAIL=

# ---- Site -------------------------------------------------------------------
# The canonical origin. Used for absolute links in emails and invoice PDFs, and
# as metadataBase so a preview deployment does not advertise itself as canonical.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cron -------------------------------------------------------------------
# Shared secret for /api/cron/*. lib/cron.ts fails CLOSED: unset, the endpoints
# refuse every request, including Vercel's own scheduler.
CRON_SECRET=
